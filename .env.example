# BlueHound example environment file
#
# BlueHound needs NO environment variables to run. Copy this file to `.env`
# only if you want to change how the development server is bound. `.env` is
# git-ignored; real environment variables always take precedence over anything
# set here.
#
# IMPORTANT: nothing in this file is compiled into the shipped application, and
# BlueHound never reads database credentials from the environment. The Neo4j
# connection (protocol, host, port, database, username, password) is entered in
# the connection modal at runtime and is deliberately not sourced from a file,
# a build artifact or a shell variable. See SECURITY.md for why.

# Interface the webpack dev server (`npm run dev`) binds to. Use 0.0.0.0 only on
# a trusted network: the dev server has no authentication and serves the
# dashboard with the full Neo4j connection form.
BLUEHOUND_DEV_HOST=localhost

# Port for the webpack dev server.
BLUEHOUND_DEV_PORT=3000
